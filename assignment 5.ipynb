   "source": [
    "import re\n",
    "\n",
    "s = input(\"Enter a string: \")\n",
    "\n",
    "pattern = r\"^[a-zA-Z0-9]+$\"\n",
    "\n",
    "if re.fullmatch(pattern, s):\n",
    "    print(\"String contains only letters and digits.\")\n",
    "else:\n",
    "    print(\"String contains other characters.\")"
   ]
